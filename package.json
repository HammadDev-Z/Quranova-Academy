{
  "name": "quranova-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:setup": "drizzle-kit push --force && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "demo:load": "tsx --env-file-if-exists=.env.local scripts/demo-data.ts load",
    "demo:remove": "tsx --env-file-if-exists=.env.local scripts/demo-data.ts remove"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

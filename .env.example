# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead alerts. Leads are always saved to data/leads.jsonl on writable hosts;
# configure SMTP to also get an email for each request and send parents a confirmation.
# Gmail: use smtp.gmail.com, port 587, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quranova Academy <you@example.com>"
LEAD_NOTIFY_EMAIL=hmddevx@gmail.com

# Spam protection (Cloudflare Turnstile, free). Leave blank to disable in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (loads only after the visitor accepts cookies)
NEXT_PUBLIC_GA_ID=

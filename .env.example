# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database. Local file for development or a VPS:
DATABASE_URL=file:./data/app.db
# Hosted SQLite for Vercel (create a free database at turso.tech):
#   DATABASE_URL=libsql://your-database.turso.io
#   DATABASE_AUTH_TOKEN=...

# First admin account, created by `npm run db:seed` (only if it does not exist yet).
# Use a long, unique password, then change it under Admin > My account.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=

# Lead alert emails. Leads are always saved to the database (Admin > Leads);
# configure SMTP to also get an email for each request and send parents a confirmation.
# Gmail: use smtp.gmail.com, port 587, and an App Password (not your normal password).
# The address that receives alerts is set in Admin > Site settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quranova Academy <you@example.com>"

# Spam protection (Cloudflare Turnstile, free). Leave blank to disable in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (loads only after the visitor accepts cookies)
NEXT_PUBLIC_GA_ID=
